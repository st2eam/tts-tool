<Panel id="enginePanel" width="980" height="472" rectAlignment="UpperCenter" color="#132018DD" padding="12 12 12 12">
  <VerticalLayout spacing="6" childForceExpandHeight="false">
    <Text id="phaseText" fontSize="34" alignment="MiddleCenter">等待开局</Text>
    <Text id="actorText" fontSize="28" alignment="MiddleCenter">当前行动：—</Text>
    <HorizontalLayout height="34" spacing="16"><Text id="callText" fontSize="22"/><Text id="minRaiseText" fontSize="22"/><Text id="potText" fontSize="22"/><Text id="sidePotText" fontSize="22"/><Text id="myBetText" fontSize="22"/></HorizontalLayout>
    <Panel id="actionPanel" active="false" height="125" color="#00000055"><VerticalLayout spacing="4"><HorizontalLayout height="48" spacing="6"><Button id="fold" onClick="Global/uiAction" fontSize="25" color="#A33">弃牌</Button><Button id="check" onClick="Global/uiAction" fontSize="25">过牌</Button><Button id="call" onClick="Global/uiAction" fontSize="25">跟注</Button><Button id="allin" onClick="Global/uiAction" fontSize="25" color="#B75">全押</Button><InputField id="amountInput" fontSize="25" characterValidation="Integer" text="100"/><Button id="betRaise" onClick="Global/uiAction" fontSize="25">下注/加注</Button></HorizontalLayout><HorizontalLayout height="40" spacing="6"><Button id="minRaise" onClick="Global/quickAmount" fontSize="20">最小加注</Button><Button id="halfPot" onClick="Global/quickAmount" fontSize="20">半池</Button><Button id="fullPot" onClick="Global/quickAmount" fontSize="20">满池</Button><Button id="allinAmount" onClick="Global/quickAmount" fontSize="20">全押金额</Button><Button id="startHand" onClick="Global/startHand" fontSize="20">开始/下一手</Button><Button id="adminReconcile" onClick="Global/adminReconcile" fontSize="20">同步筹码</Button></HorizontalLayout></VerticalLayout></Panel>
    <Panel id="runPanel" active="false" height="50" color="#543600CC"><HorizontalLayout spacing="8"><Text fontSize="24">全下跑马：</Text><Button id="runOne" onClick="Global/voteRun" fontSize="24">跑一次</Button><Button id="runTwo" onClick="Global/voteRun" fontSize="24">跑两次</Button><Button id="forceOne" onClick="Global/forceRun" fontSize="24">强制一次</Button><Button id="forceTwo" onClick="Global/forceRun" fontSize="24">强制两次</Button></HorizontalLayout></Panel>
    <HorizontalLayout height="34" spacing="6"><Text fontSize="18">开局前设置　小盲</Text><InputField id="smallBlindInput" width="90" fontSize="20" characterValidation="Integer" text="50"/><Text fontSize="18">大盲</Text><InputField id="bigBlindInput" width="90" fontSize="20" characterValidation="Integer" text="100"/><Text fontSize="18">买入</Text><InputField id="buyInInput" width="130" fontSize="20" characterValidation="Integer" text="10000"/><Button id="applySettings" onClick="Global/applySettings" fontSize="18">应用设置</Button></HorizontalLayout>
    <HorizontalLayout height="26" spacing="8"><Text id="seatWhite" fontSize="16"/><Text id="seatRed" fontSize="16"/><Text id="seatOrange" fontSize="16"/><Text id="seatYellow" fontSize="16"/><Text id="seatGreen" fontSize="16"/><Text id="seatBlue" fontSize="16"/><Text id="seatPurple" fontSize="16"/><Text id="seatPink" fontSize="16"/></HorizontalLayout>
  </VerticalLayout>
</Panel>
